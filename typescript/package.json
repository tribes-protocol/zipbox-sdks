{
  "name": "@zipbox/sdk",
  "version": "0.1.1",
  "description": "Drive Zipbox boxes from code: create, exec, files, PTY, previews.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://zipbox.ai/docs/sdk-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tribes-protocol/zipbox-sdks.git",
    "directory": "typescript"
  },
  "keywords": [
    "zipbox",
    "sandbox",
    "agents",
    "mcp",
    "exec"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.vitest.json --noEmit",
    "test:unit": "vitest run",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored",
    "lint:fix": "eslint . --fix --max-warnings 0 --no-warn-ignored",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,md,json}\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/node": "20.17.6",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.3.3",
    "rimraf": "6.1.3",
    "typescript": "5.8.3",
    "vitest": "4.1.3"
  }
}
