{
  "name": "sandboxes_get",
  "description": "GET /sandbox/:id returns the box with ready/baseUrl/boxToken.",
  "call": {
    "op": "sandboxes.get",
    "args": {
      "id": "sbx_1"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "demo",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "running",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "cpuPct": 3,
          "memPct": 10,
          "diskPct": 20,
          "createdAt": "2026-10-19T00:00:00.000Z",
          "updatedAt": "2026-10-19T00:00:00.000Z",
          "ready": true,
          "baseUrl": "{{BASE}}",
          "boxToken": "bt_test_token"
        }
      }
    }
  ],
  "expect": {
    "result": {
      "id": "sbx_1",
      "status": "running",
      "ready": true,
      "baseUrl": "{{BASE}}"
    }
  }
}
