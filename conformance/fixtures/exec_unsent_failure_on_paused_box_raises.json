        "path": "/sandbox/sbx_1",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "demo",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "running",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "createdAt": "2026-11-10T00:00:00.000Z",
          "updatedAt": "2026-11-10T00:00:00.000Z",
          "ready": true,
          "baseUrl": "{{DEAD}}",
