{
  "name": "sandboxes_wait_ready",
  "description": "waitReady re-reads GET /sandbox/:id with backoff until the box is ready.",
  "call": {
    "op": "sandboxes.waitReady",
    "args": {
      "id": "sbx_1"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1/wait?until=ready",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "demo",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "provisioning",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "cpuPct": 3,
          "memPct": 10,
          "diskPct": 20,
          "createdAt": "2026-10-29T00:00:00.000Z",
          "updatedAt": "2026-10-29T00:00:00.000Z",
          "ready": false,
          "baseUrl": null,
          "boxToken": null
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1/wait?until=ready",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "demo",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "running",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "cpuPct": 3,
          "memPct": 10,
          "diskPct": 20,
          "createdAt": "2026-10-29T00:00:00.000Z",
          "updatedAt": "2026-10-29T00:00:00.000Z",
          "ready": true,
          "baseUrl": "{{BASE}}",
          "boxToken": "bt_test_token"
        }
      }
    }
  ],
  "expect": {
    "result": {
      "id": "sbx_1",
      "ready": true,
      "baseUrl": "{{BASE}}"
    }
  }
}
