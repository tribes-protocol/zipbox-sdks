{
  "name": "sandboxes_fork_retries_unavailable_same_key",
  "description": "A 503 unavailable on the fork POST is retried after Retry-After with the SAME Idempotency-Key and the same body, so a retry can never make two children. wait: false returns the accepted child at once (status provisioning, not ready, carrying the fork) without reading it again.",
  "call": {
    "op": "sandboxes.fork",
    "args": {
      "id": "sbx_1",
      "name": "demo-2",
      "sourcePolicy": "pause_and_resume",
      "wait": false
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/sandbox/sbx_1/fork",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT",
          "idempotency-key": "{{ANY}}",
          "content-type": "application/json"
        },
        "body": {
          "name": "demo-2",
          "sourcePolicy": "pause_and_resume"
        }
      },
      "response": {
        "status": 503,
        "body": {
          "error": {
            "code": "unavailable",
            "message": "The source's host has no room for a fork right now.",
            "requestId": "req_test",
            "retryable": true,
            "retryAfterMs": 0,
            "docsUrl": "https://zipbox.ai/docs/errors#unavailable"
          }
        },
        "headers": {
          "retry-after": "0"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/sandbox/sbx_1/fork",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT",
          "idempotency-key": "{{SAME}}",
          "content-type": "application/json"
        },
        "body": {
          "name": "demo-2",
          "sourcePolicy": "pause_and_resume"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "operationId": "fork_1",
          "sandbox": {
            "id": "sbx_2",
            "name": "demo-2",
            "domain": "zbox.sh",
            "ipv6": null,
            "status": "provisioning",
            "tier": "s",
            "pendingTier": null,
            "isArchived": false,
            "privateMode": false,
            "tailscale": null,
            "agentPublicKey": null,
            "fork": {
              "operationId": "fork_1",
              "sourceSandboxId": "sbx_1",
              "childSandboxId": "sbx_2",
              "sourcePolicy": "pause_and_resume",
              "phase": "queued",
              "sourceRecovery": "pending",
              "captureMode": null,
              "waitingOn": null,
              "attempt": 0,
              "nextAttemptAt": null,
              "cancelRequestedAt": null,
              "error": null,
              "createdAt": "2026-11-05T00:00:00.000Z",
              "updatedAt": "2026-11-05T00:00:00.000Z",
              "completedAt": null
            },
            "createdAt": "2026-11-05T00:00:00.000Z",
            "updatedAt": "2026-11-05T00:00:00.000Z"
          },
          "fork": {
            "operationId": "fork_1",
            "sourceSandboxId": "sbx_1",
            "childSandboxId": "sbx_2",
            "sourcePolicy": "pause_and_resume",
            "phase": "queued",
            "sourceRecovery": "pending",
            "captureMode": null,
            "waitingOn": null,
            "attempt": 0,
            "nextAttemptAt": null,
            "cancelRequestedAt": null,
            "error": null,
            "createdAt": "2026-11-05T00:00:00.000Z",
            "updatedAt": "2026-11-05T00:00:00.000Z",
            "completedAt": null
          }
        }
      }
    }
  ],
  "expect": {
    "result": {
      "id": "sbx_2",
      "name": "demo-2",
      "status": "provisioning",
      "ready": false,
      "fork": {
        "operationId": "fork_1",
        "sourceSandboxId": "sbx_1",
        "childSandboxId": "sbx_2",
        "sourcePolicy": "pause_and_resume",
        "phase": "queued"
      }
    }
  }
}
