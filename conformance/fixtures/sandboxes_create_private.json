{
  "name": "sandboxes_create_private",
  "description": "create with private: true sends it on the claim body and returns once the box is running with its key. A private box is not ready until it joins a tailnet, so create does not wait for ready.",
  "call": {
    "op": "sandboxes.create",
    "args": {
      "name": "demo",
      "private": true
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/sandbox/identity/claim",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT",
          "content-type": "application/json",
          "idempotency-key": "{{ANY}}"
        },
        "body": {
          "name": "demo",
          "private": true
        }
      },
      "response": {
        "status": 200,
        "body": {
          "sandboxId": "sbx_1",
          "userId": "did:privy:u",
          "hostId": "h1",
          "name": "demo",
          "region": "eu",
          "status": "provisioning",
          "created": true,
          "createdAt": "2026-10-19T00:00:00.000Z",
          "updatedAt": "2026-10-19T00:00:00.000Z"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "demo",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "provisioning",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "privateMode": true,
          "agentPublicKey": null,
          "tailscale": null,
          "createdAt": "2026-10-19T00:00:00.000Z",
          "updatedAt": "2026-10-19T00:00:00.000Z",
          "ready": false,
          "baseUrl": null,
          "boxToken": null
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "demo",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "running",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "privateMode": true,
          "agentPublicKey": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAENj+qimupfFq/bb5ok8+RD0Bh7Opby1hPK28tSUvvLn58j9QLIPm1e1mfo7z5H/kbmtn7lKcNZp7cT+1Lf5Enog==",
          "tailscale": null,
          "createdAt": "2026-10-19T00:00:00.000Z",
          "updatedAt": "2026-10-19T00:00:00.000Z",
          "ready": false,
          "baseUrl": null,
          "boxToken": null
        }
      }
    }
  ],
  "expect": {
    "result": {
      "id": "sbx_1",
      "status": "running",
      "privateMode": true,
      "agentPublicKey": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAENj+qimupfFq/bb5ok8+RD0Bh7Opby1hPK28tSUvvLn58j9QLIPm1e1mfo7z5H/kbmtn7lKcNZp7cT+1Lf5Enog==",
      "ready": false
    }
  }
}
