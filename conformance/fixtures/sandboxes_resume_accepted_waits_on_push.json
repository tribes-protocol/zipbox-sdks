{
  "name": "sandboxes_resume_accepted_waits_on_push",
  "description": "A resume answered 202 (a cold resume is a boot) waits on GET /sandbox/:id/wait?until=ready until it reads ready.",
  "call": {
    "op": "sandboxes.resume",
    "args": {
      "id": "sbx_1"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/sandbox/sbx_1/resume",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "id": "sbx_1",
          "name": "worker-1",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "provisioning",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "cpuPct": null,
          "memPct": null,
          "diskPct": null,
          "createdAt": "2026-11-11T00:00:00.000Z",
          "updatedAt": "2026-11-11T00:00:00.000Z",
          "ready": false,
          "readiness": "settling",
          "httpsReady": false,
          "baseUrl": null,
          "boxToken": null,
          "phase": "starting",
          "allowedActions": ["cancel_transition", "delete"]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1/wait?until=ready",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "worker-1",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "running",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "cpuPct": 3,
          "memPct": 10,
          "diskPct": 20,
          "createdAt": "2026-11-11T00:00:00.000Z",
          "updatedAt": "2026-11-11T00:00:00.000Z",
          "ready": true,
          "readiness": "ready",
          "httpsReady": true,
          "baseUrl": "{{BASE}}",
          "boxToken": "bt_test_token",
          "phase": "running",
          "allowedActions": ["pause", "restart", "delete", "fork"]
        }
      }
    }
  ],
  "expect": {
    "result": {
      "id": "sbx_1",
      "status": "running",
      "readiness": "ready"
    }
  }
}
