{
  "name": "sandboxes_get_retries_bad_gateway",
  "description": "A 502 with no envelope on a GET is box_not_running, which is retryable, so the GET is retried like any retryable error.",
  "call": {
    "op": "sandboxes.get",
    "args": {
      "id": "sbx_1"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 502,
        "headers": {
          "content-type": "text/plain"
        },
        "bodyText": "Bad Gateway"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "demo",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "running",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "createdAt": "2026-11-09T00:00:00.000Z",
          "updatedAt": "2026-11-09T00:00:00.000Z",
          "ready": true,
          "baseUrl": "{{BASE}}",
          "boxToken": "bt_test_token",
          "phase": "running",
          "allowedActions": ["pause", "restart", "delete", "fork"],
          "readiness": "ready"
        }
      }
    }
  ],
  "expect": {
    "result": {
      "id": "sbx_1",
      "ready": true
    }
  }
}
