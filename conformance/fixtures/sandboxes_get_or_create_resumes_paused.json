{
  "name": "sandboxes_get_or_create_resumes_paused",
  "description": "getOrCreate on a name whose box is paused resumes it: the resume is accepted with the box still settling (202), then the wait answers it ready. It never hands back the paused box and never creates a second one.",
  "call": {
    "op": "sandboxes.getOrCreate",
    "args": {
      "name": "worker-1"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/sandbox",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": [
          {
            "id": "sbx_1",
            "name": "worker-1",
            "domain": "zbox.sh",
            "ipv6": "2a01::1",
            "status": "paused",
            "tier": "s",
            "pendingTier": null,
            "isArchived": true,
            "cpuPct": null,
            "memPct": null,
            "diskPct": null,
            "createdAt": "2026-11-10T00:00:00.000Z",
            "updatedAt": "2026-11-10T00:00:00.000Z",
            "phase": "paused",
            "allowedActions": ["resume", "delete"]
          }
        ]
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/sandbox/sbx_1/resume",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "id": "sbx_1",
          "name": "worker-1",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "provisioning",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "cpuPct": null,
          "memPct": null,
          "diskPct": null,
          "createdAt": "2026-11-11T00:00:00.000Z",
          "updatedAt": "2026-11-11T00:00:00.000Z",
          "ready": false,
          "readiness": "settling",
          "httpsReady": false,
          "baseUrl": null,
          "boxToken": null,
          "phase": "starting",
          "allowedActions": ["cancel_transition", "delete"]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1/wait?until=ready",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "worker-1",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "provisioning",
          "tier": "s",
          "pendingTier": null,
          "isArchived": true,
          "cpuPct": null,
          "memPct": null,
          "diskPct": null,
          "createdAt": "2026-11-10T00:00:00.000Z",
          "updatedAt": "2026-11-10T00:00:00.000Z",
          "ready": false,
          "baseUrl": null,
          "boxToken": null,
          "phase": "starting",
          "allowedActions": ["cancel_transition", "delete"],
          "readiness": "settling"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1/wait?until=ready",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "worker-1",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "running",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "cpuPct": 3,
          "memPct": 10,
          "diskPct": 20,
          "createdAt": "2026-11-10T00:00:00.000Z",
          "updatedAt": "2026-11-10T00:00:00.000Z",
          "ready": true,
          "baseUrl": "{{BASE}}",
          "boxToken": "bt_test_token",
          "phase": "running",
          "allowedActions": ["pause", "restart", "delete", "fork"],
          "readiness": "ready"
        }
      }
    }
  ],
  "expect": {
    "result": {
      "id": "sbx_1",
      "ready": true,
      "baseUrl": "{{BASE}}"
    }
  }
}
