{
  "name": "sandbox_logs_filters",
  "description": "logs runs journalctl with --since, -n and -u in that order and returns its stdout.",
  "call": {
    "op": "sandbox.logs",
    "args": {
      "id": "sbx_1",
      "since": "10 min ago",
      "lines": 50,
      "unit": "caddy"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "demo",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "running",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "cpuPct": 3,
          "memPct": 10,
          "diskPct": 20,
          "createdAt": "2026-10-29T00:00:00.000Z",
          "updatedAt": "2026-10-29T00:00:00.000Z",
          "ready": true,
          "baseUrl": "{{BASE}}",
          "boxToken": "bt_test_token"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/exec",
        "headers": {
          "authorization": "Bearer bt_test_token"
        },
        "body": {
          "argv": [
            "journalctl",
            "-o",
            "short-iso",
            "--no-pager",
            "--since",
            "10 min ago",
            "-n",
            "50",
            "-u",
            "caddy"
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "bodyText": "id: 0-0\nevent: start\ndata: {\"id\":\"cmd_1\"}\n\nid: 12-0\nevent: stdout\ndata: {\"data\":\"caddy started\\n\"}\n\nid: 12-0\nevent: exit\ndata: {\"state\":\"exited\",\"exitCode\":0,\"signal\":null,\"timedOut\":false}\n\n"
      }
    }
  ],
  "expect": {
    "result": {
      "text": "caddy started\n"
    }
  }
}
