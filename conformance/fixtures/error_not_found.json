{
  "name": "error_not_found",
  "description": "An error envelope surfaces as a typed error carrying code, status, requestId and docsUrl.",
  "call": {
    "op": "sandboxes.get",
    "args": {
      "id": "nope"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/nope",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 404,
        "body": {
          "error": {
            "code": "not_found",
            "message": "Sandbox not found",
            "requestId": "req_test",
            "retryable": false,
            "retryAfterMs": null,
            "docsUrl": "https://zipbox.ai/docs/errors#not_found"
          }
        }
      }
    }
  ],
  "expect": {
    "error": {
      "code": "not_found",
      "status": 404,
      "requestId": "req_test",
      "docsUrl": "https://zipbox.ai/docs/errors#not_found"
    }
  }
}
