          "ready": false,
          "readiness": "settling",
          "httpsReady": false,
          "baseUrl": null,
          "boxToken": null,
          "phase": "stopping",
          "allowedActions": ["cancel_transition", "delete"]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
