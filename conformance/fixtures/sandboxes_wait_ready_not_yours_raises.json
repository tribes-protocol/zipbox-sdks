{
  "name": "sandboxes_wait_ready_not_yours_raises",
  "description": "GET /sandbox/:id/wait answers 404 and so does GET /sandbox/:id: the box is gone or not the caller's, so the wait raises not_found instead of falling back to polling.",
  "call": {
    "op": "sandboxes.waitReady",
    "args": {
      "id": "sbx_1"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1/wait?until=ready",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 404,
        "body": {
          "error": {
            "code": "not_found",
            "message": "Sandbox not found",
            "requestId": "req_test",
            "retryable": false,
            "retryAfterMs": null,
            "docsUrl": "https://zipbox.ai/docs/errors#not_found"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 404,
        "body": {
          "error": {
            "code": "not_found",
            "message": "Sandbox not found",
            "requestId": "req_test",
            "retryable": false,
            "retryAfterMs": null,
            "docsUrl": "https://zipbox.ai/docs/errors#not_found"
          }
        }
      }
    }
  ],
  "expect": {
