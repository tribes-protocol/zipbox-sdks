          "status": "running",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "cpuPct": 3,
          "memPct": 10,
          "diskPct": 20,
          "createdAt": "2026-10-29T00:00:00.000Z",
          "updatedAt": "2026-10-29T00:00:00.000Z",
          "ready": true,
          "baseUrl": "{{BASE}}",
          "boxToken": "bt_test_token"
        }
      }
    }
  ],
  "expect": {
    "error": {
      "code": "conflict",
      "status": 409,
      "requestId": "req_test"
    }
  }
}
