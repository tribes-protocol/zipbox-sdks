{
  "name": "preview_create",
  "description": "preview.create execs tribes-caddy add <label>.<box host> 127.0.0.1:<port> and returns https://<label>.<box host>.",
  "call": {
    "op": "preview.create",
    "args": {
      "id": "sbx_1",
      "port": 3000,
      "label": "web"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/sandbox/sbx_1",
        "headers": {
          "authorization": "Bearer zb_TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "sbx_1",
          "name": "demo",
          "domain": "zbox.sh",
          "ipv6": "2a01::1",
          "status": "running",
          "tier": "s",
          "pendingTier": null,
          "isArchived": false,
          "cpuPct": 3,
          "memPct": 10,
          "diskPct": 20,
          "createdAt": "2026-10-19T00:00:00.000Z",
          "updatedAt": "2026-10-19T00:00:00.000Z",
          "ready": true,
          "baseUrl": "{{BASE}}",
          "boxToken": "bt_test_token"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/exec",
        "headers": {
          "authorization": "Bearer bt_test_token"
        },
        "body": {
          "argv": ["tribes-caddy", "add", "web.{{HOST}}", "127.0.0.1:3000"]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "bodyText": "id: 0-0\nevent: start\ndata: {\"id\":\"cmd_p\"}\n\nid: 0-0\nevent: exit\ndata: {\"state\":\"exited\",\"exitCode\":0,\"signal\":null,\"timedOut\":false}\n\n"
      }
    }
  ],
  "expect": {
    "result": {
      "url": "https://web.{{HOST}}"
    }
  }
}
